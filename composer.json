{
    "name": "mathsgod/light-db-graphqlite-mappers",
    "license": "MIT",
    "description": "Light DB GraphQLite Mappers",
    "authors": [
        {
            "name": "Raymond Chong",
            "email": "mathsgod@yahoo.com"
        }
    ],
    "require": {
        "thecodingmachine/graphqlite": "^8.0",
        "php": ">=8.3",
        "mathsgod/light-db": "^2.0@dev"
    },
    "autoload": {
        "psr-4": {
            "Light\\Db\\GraphQLite\\Mappers\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "path",
            "url": "../light-db-new",
            "options": {
                "versions": {
                    "mathsgod/light-db": "2.0.x-dev"
                }
            }
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
